// PairShake's backend for the iPhone app, all on Cloudflare: https://pairshake.binjto.workers.dev. Deploy with ./deploy.sh (it copies app/web in first).
// Secrets (set with `wrangler secret put`): GEMINI_API_KEY, ELEVENLABS_API_KEY, ADMIN_TOKEN.
{
  "name": "pairshake",
  "account_id": "662aad26c7f15dc72bb81dfbd929e7d4",
  "main": "src/index.js",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  // the app's page and Emma's hands (copied from ../app/web by deploy.sh); the Worker goes first so the API is never a file
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  // the room: every person, introduction and chat (room.js)
  "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "PairShake" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PairShake"] }],
  // the database: users, introductions and their chats (D1, SQL). The room loads it at start and writes every change through.
  "d1_databases": [{ "binding": "DB", "database_name": "pairshake", "database_id": "5899aa3e-aa28-4298-b733-6c9de9262f7b", "migrations_dir": "migrations" }],
  // every line Emma has said, in her voice, kept for good
  "r2_buckets": [{ "binding": "VOICE", "bucket_name": "pairshake-voice" }],
  // Emma's ears (Whisper) and her stand-in voice when ElevenLabs is down
  "ai": { "binding": "AI" },
  // what costs money per call, per address and path
  "ratelimits": [{ "name": "LIMIT", "namespace_id": "8780", "simple": { "limit": 300, "period": 60 } }]
}

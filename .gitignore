# iOS app: build output and per-user Xcode state
app/build/
xcuserdata/
*.xcuserstate

# Cloudflare Worker (edge/): local wrangler state and the copied models (deploy.sh makes them)
edge/.wrangler/
edge/public/
node_modules/

.DS_Store
__pycache__/

# Local runtime state, logs and diagnostics
server/room.json
server/*.log
server/*.jsonl
server/voice_cache/

# API keys
.env
.dev.vars

# Room backups (personal data)
backups/

# Self-signed TLS key for local testing
server/certs/
